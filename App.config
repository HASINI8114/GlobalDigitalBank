<?xml version="1.0" encoding="utf-8" ?>

<configuration>

	<connectionStrings>

		<add
		  name="GDBConnection"
		  connectionString="Server=localhost,14333;Database=GDBDatabase;Trusted_Connection=True;TrustServerCertificate=True;"
		  providerName="System.Data.SqlClient" />

	</connectionStrings>
	<appSettings>
		<add
					key="ProviderFactory"
					value="System.Data.SqlClient.SqlClientFactory, System.Data.SqlClient" />
	</appSettings>

</configuration>